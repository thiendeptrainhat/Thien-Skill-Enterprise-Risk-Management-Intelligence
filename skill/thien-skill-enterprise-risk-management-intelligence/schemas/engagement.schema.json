{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thien:erm:engagement:1",
  "title": "ERM engagement snapshot 1",
  "type": "object",
  "properties": {
    "context": {"$ref": "#/$defs/context"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "taxonomy": {
      "type": "array",
      "items": {"$ref": "#/$defs/taxonomy"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/risk"}
    },
    "methods": {
      "type": "array",
      "items": {"$ref": "#/$defs/method"}
    },
    "assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assessment"}
    },
    "metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metric"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "controls": {
      "type": "array",
      "items": {"$ref": "#/$defs/control"}
    },
    "scenarios": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"}
    },
    "losses": {
      "type": "array",
      "items": {"$ref": "#/$defs/loss"}
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "treatments": {
      "type": "array",
      "items": {"$ref": "#/$defs/treatment"}
    },
    "handoffs": {
      "type": "array",
      "items": {"$ref": "#/$defs/handoff"}
    }
  },
  "required": ["context", "sources", "taxonomy", "risks", "methods", "assessments", "metrics", "observations", "controls", "scenarios", "losses", "dependencies", "treatments", "handoffs"],
  "additionalProperties": false,
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date"},
        "entity": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "jurisdictions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "currency": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "industry": {"type": "string", "minLength": 1},
        "objectives": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "materiality": {"type": "string", "minLength": 1},
        "synthetic": {"type": "boolean"},
        "decision": {"type": "string", "minLength": 1}
      },
      "required": ["id", "version", "as_of", "entity", "scope", "jurisdictions", "currency", "horizon", "unit", "industry", "objectives", "materiality", "synthetic", "decision"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date"},
        "kind": {"enum": ["fact", "estimate", "model", "assumption", "synthetic"]},
        "status": {"enum": ["current", "superseded", "access_limited", "unverified"]},
        "replaced_by": {"type": ["string", "null"]},
        "limitations": {"type": "string"}
      },
      "required": ["id", "title", "locator", "version", "accessed_at", "kind", "status", "replaced_by", "limitations"],
      "additionalProperties": false
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 0, "maximum": 2},
        "parent_id": {"type": ["string", "null"]}
      },
      "required": ["id", "label", "level", "parent_id"],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "taxonomy_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "cause": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "exposure": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "taxonomy_id", "title", "cause", "event", "impact", "objective", "owner", "scope", "exposure", "evidence_ids"],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "approval": {"enum": ["draft", "approved"]},
        "approved_by": {"type": ["string", "null"]},
        "impact_levels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "likelihood_levels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "rating_basis": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1}
      },
      "required": ["id", "version", "approval", "approved_by", "impact_levels", "likelihood_levels", "rating_basis", "horizon"],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "risk_id": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "minLength": 1},
        "basis": {"enum": ["inherent", "current", "target"]},
        "as_of": {"type": "string", "format": "date"},
        "horizon": {"type": "string", "minLength": 1},
        "impact": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "likelihood": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "rating": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "risk_id", "method_id", "basis", "as_of", "horizon", "impact", "likelihood", "rating", "rationale", "evidence_ids"],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "op": {"enum": [">", ">=", "<", "<="]},
        "threshold": {"type": ["number", "string"]},
        "severity": {"enum": ["warning", "breach", "capacity_breach"]}
      },
      "required": ["op", "threshold", "severity"],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "risk_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "unit": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "bad_direction": {"enum": ["higher", "lower", "two_sided"]},
        "formula": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "frequency": {"type": "string", "minLength": 1},
        "max_age_days": {"type": "integer", "minimum": 0},
        "approval": {"enum": ["draft", "approved"]},
        "approved_by": {"type": ["string", "null"]},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule"}
        },
        "action": {"type": "string", "minLength": 1},
        "utilization_applicable": {"type": "boolean"}
      },
      "required": ["id", "label", "risk_ids", "unit", "currency", "horizon", "scope", "bad_direction", "formula", "owner", "frequency", "max_age_days", "approval", "approved_by", "rules", "action"],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date"},
        "value": {"type": ["number", "string", "null"]},
        "quality": {"enum": ["valid", "missing", "stale", "unverified"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "unit": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "required": ["id", "metric_id", "as_of", "value", "quality", "evidence_ids", "unit", "currency", "horizon", "scope"],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "risk_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "label": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "state": {"enum": ["expected", "designed", "current"]},
        "design_conclusion": {"type": "string", "minLength": 1},
        "operating_conclusion": {"type": "string", "minLength": 1},
        "design_evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "operating_evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "rcsa": {"type": "string", "minLength": 1}
      },
      "required": ["id", "risk_ids", "label", "owner", "state", "design_conclusion", "operating_conclusion", "design_evidence_ids", "operating_evidence_ids", "rcsa"],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["sensitivity", "scenario", "stress", "reverse_stress", "forecast"]},
        "horizon": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "transmission": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "label", "kind", "horizon", "baseline", "assumptions", "transmission", "result", "limitations", "evidence_ids"],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "risk_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "amount": {"type": ["number", "string"]},
        "currency": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "eliminated": {"type": "boolean"},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "risk_ids", "amount", "currency", "horizon", "scope", "eliminated", "evidence_ids"],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from_risk_id": {"type": "string", "minLength": 1},
        "to_risk_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["common_mode", "cascade", "concentration", "other"]},
        "mechanism": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "from_risk_id", "to_risk_id", "kind", "mechanism", "evidence_ids"],
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "risk_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "option": {"enum": ["avoid", "reduce", "transfer", "accept", "exploit"]},
        "action": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "deadline": {"type": "string", "format": "date"},
        "status": {"enum": ["proposed", "approved", "in_progress", "complete", "overdue"]},
        "cost": {"type": ["number", "string"]},
        "currency": {"type": "string", "minLength": 1},
        "lead_time": {"type": "string", "minLength": 1},
        "resource_constraint": {"type": "string", "minLength": 1},
        "secondary_risk": {"type": "string", "minLength": 1},
        "expected_benefit": {"type": "string", "minLength": 1},
        "benefit_basis": {"enum": ["assumed", "modelled", "observed"]},
        "acceptance_authority": {"type": ["string", "null"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "no_action_case": {"type": ["string", "null"], "minLength": 1},
        "target": {"type": ["string", "null"], "minLength": 1},
        "target_assessment_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "risk_ids", "option", "action", "owner", "deadline", "status", "cost", "currency", "lead_time", "resource_constraint", "secondary_risk", "expected_benefit", "benefit_basis", "acceptance_authority", "evidence_ids"],
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "specialist": {"type": "string", "minLength": 1},
        "capability_status": {"enum": ["verified", "unavailable", "unverified"]},
        "version": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date"},
        "input_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "constraints": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "string", "minLength": 1},
        "output_contract": {"type": "string", "minLength": 1},
        "result_status": {"enum": ["not_run", "received", "validated", "rejected"]},
        "method": {"type": ["string", "null"]},
        "validation_status": {"enum": ["PASS", "PASS_WITH_LIMITS", "FAIL", "NOT_RUN", null]},
        "limitations": {"type": "string", "minLength": 1},
        "monitoring": {"type": "string", "minLength": 1},
        "validation_evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["id", "specialist", "capability_status", "version", "question", "target", "horizon", "as_of", "input_refs", "constraints", "acceptance_criteria", "output_contract", "result_status", "method", "validation_status", "limitations", "monitoring"],
      "additionalProperties": false
    }
  }
}
